<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargos</title>
</head>
<body>
    <nav>
        <a href="/">Inicio</a> |
        <a href="/candidatos/nuevo">Nuevo Candidato</a> |
        <a href="/cargos">Cargos</a> |
        <a href="/lugares">Lugares</a>
    </nav>
    <h1>Lista de Cargos</h1>
    <form method="POST" action="/cargos">
        <label for="nombre">Nombre:</label>
        <input type="text" id="nombre" name="nombre" maxlength="50" required>
        <button type="submit">Agregar cargo</button>
    </form>
    <table border="1">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% cargos.forEach(cargo => { %>
                <tr>
                    <td><%= cargo.id %></td>
                    <td><%= cargo.nombre %></td>
                    <td>
                        <a href="/cargos/editar/<%= cargo.id %>">Editar</a> |
                        <a href="/cargos/eliminar/<%= cargo.id %>">Eliminar</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>